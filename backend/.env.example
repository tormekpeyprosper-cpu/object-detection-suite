# ==============================================================================
# Shared Object Detection Backend Environment Configuration
# ==============================================================================

# Server configuration
HOST=0.0.0.0
PORT=8000

# Supabase Authentication & Project Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_publishable_key

# Ultralytics Hub / YOLO Cloud API Endpoint & Bearer Token
# Leave empty or keep placeholder to stay in Mock Mode until 1,000-image dataset is finalized
ULTRALYTICS_ENDPOINT_URL=
ULTRALYTICS_API_KEY=

# Default inference hyperparameters
DEFAULT_CONF=0.25
DEFAULT_IOU=0.50
DEFAULT_IMGSZ=640
